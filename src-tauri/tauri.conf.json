{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "口袋挂机",
  "version": "1.0.8",
  "identifier": "com.pokemon.idle",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "口袋挂机",
        "label": "main",
        "width": 640,
        "height": 800,
        "resizable": false,
        "fullscreen": false,
        "transparent": false,
        "decorations": false,
        "visible": false,
        "dragDropEnabled": true,
        "focusable": true,
        "maximizable": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "nsis/installer-sidebar.bmp",
        "headerImage": "nsis/installer-header.bmp"
      }
    }
  }
}
